# Copy to .env for local runs. On Render/Railway set these as environment variables instead.

# ---- AI provider: groq | gemini | openrouter | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_API_KEY=gsk_paste_your_groq_key_here
# optional overrides (defaults: groq=llama-3.3-70b-versatile, gemini=gemini-2.5-flash, ollama=llama3.2:3b)
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=
LLM_TIMEOUT=180
COLUMNS_PER_CALL=3            # 1 = one AI call per column (deepest), 3-5 = fewer calls for free tiers
SUMMARIZE_PLAN=true
ALLOW_RULE_FALLBACK=true
ALLOW_CLIENT_SETTINGS=false   # true lets anyone using the site change provider/key -> only for local use

# ---- database: Postgres (Neon/Render/Supabase) or SQLite for local use
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# ---- limits
MAX_UPLOAD_MB=10
MAX_ROWS=100000
MAX_COLUMNS=200
DATASET_TTL_DAYS=7
MAX_DATASETS_PER_SESSION=20
MAX_CONCURRENT_JOBS=2

# ---- web
ALLOWED_ORIGINS=*             # hosted: https://YOUR-USERNAME.github.io
SERVE_FRONTEND=true           # also serve the UI from the backend URL

# ---- local Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
